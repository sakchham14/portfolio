services:
  portfolio:
    build:
      context: .
      dockerfile: Dockerfile
    image: sakchham-portfolio:latest
    container_name: sakchham-portfolio
    restart: unless-stopped
    expose:
      - "3000:3001"
    environment:
      - NODE_ENV=production
    healthcheck:
      test: ["CMD", "wget", "--spider", "http://localhost:3001"]
      interval: 30s
      timeout: 10s
      retries: 3

  nginx:
    image: nginx:stable-alpine
    container_name: sakchham-portfolio-nginx
    restart: unless-stopped
    ports:
      - "80:80"
    depends_on:
      - portfolio
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
